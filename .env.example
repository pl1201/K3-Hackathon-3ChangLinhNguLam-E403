# Copy this file to .env. Never commit real keys.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM provider: openai or deepseek
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required only by visual_summarization
LLAMA_CLOUD_API_KEY=

# Langfuse (optional locally, required in staging/production)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Runtime controls
ENABLE_LLM=true
ENABLE_TRACING=true
ENABLE_LANGFUSE_PROMPTS=false
LLM_TIMEOUT_SECONDS=30
MAX_CONTEXT_CHARS=12000
ENABLE_MOCK_FALLBACK=true
